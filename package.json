{
  "name": "dataplay_next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next out",
    "analyze": "ANALYZE=true npm run build",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "analyze:lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "perf:audit": "npm run build && npm run analyze:bundle",
    "perf:dev": "npm run dev -- --experimental-debug",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:debug": "jest --detectOpenHandles --forceExit",
    "preview": "next build && next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-all": "npm run lint && npm run type-check && npm run test",
    "pre-commit": "npm run format && npm run lint:fix && npm run type-check",
    "pre-push": "npm run test:ci && npm run build",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix",
    "deps:update": "npm update",
    "deps:outdated": "npm outdated",
    "deps:check": "npm run deps:outdated && npm run security:audit",
    "docs:build": "typedoc --out docs src",
    "docs:serve": "serve docs",
    "db:seed": "node scripts/seed-database.js",
    "db:migrate": "node scripts/migrate-database.js",
    "backup:create": "node scripts/create-backup.js",
    "backup:restore": "node scripts/restore-backup.js",
    "monitor:start": "node scripts/start-monitoring.js",
    "monitor:stop": "node scripts/stop-monitoring.js",
    "deploy:staging": "npm run build && npm run test:ci && npm run deploy:staging:upload",
    "deploy:production": "npm run build && npm run test:ci && npm run deploy:production:upload",
    "deploy:staging:upload": "node scripts/deploy-staging.js",
    "deploy:production:upload": "node scripts/deploy-production.js",
    "health:check": "node scripts/health-check.js",
    "logs:view": "node scripts/view-logs.js",
    "logs:clear": "node scripts/clear-logs.js",
    "metrics:collect": "node scripts/collect-metrics.js",
    "metrics:export": "node scripts/export-metrics.js",
    "backup:schedule": "node scripts/schedule-backups.js",
    "maintenance:start": "node scripts/start-maintenance.js",
    "maintenance:end": "node scripts/end-maintenance.js"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.12.2",
    "classnames": "^2.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "next": "15.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "swiper": "^12.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
