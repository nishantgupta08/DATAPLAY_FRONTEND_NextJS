    "courses": [
        {
            "id": 1,
            "title": "Data Analyst",
            "sub_title": "Make businesses smarter with data. In this hands-on, project-first course, you’ll learn to wrangle messy datasets, build dashboards people actually use, and present insights that drive action. No fluff—just the skills hiring managers ask for.",
            "img_url": "https://res.cloudinary.com/dd0e4iwau/image/upload/v1759480655/Group_217_youx1q.png",
            "courses_content": [
                {
                    "title": "Databases and SQL Fundamentals",
                    "content": [
                        "Introduction to Databases",
                        "Types of databases: Relational (RDBMS) vs NoSQL",
                        "Use cases and differences",
                        "Relational Database Concepts",
                        "Basic SQL Queries (select, joins, subquery, aggregation, Transaction handling)",
                        "Advanced SQL Queries (CTE, Window functions, Stored procedure, Functions)",
                        "Indexes and Performance Optimization",
                        "Introduction to NoSQL Databases (Overview)"
                    ]
                },
                {
                    "title": "Excel for Data Analysis",
                    "content": [
                        "Data cleaning using Excel tools",
                        "Pivot tables and VLOOKUP/XLOOKUP",
                        "Charts and dashboards",
                        "Basic Excel formulas for analysis"
                    ]
                },
                {
                    "title": "Statistics Fundamentals",
                    "content": [
                        "Descriptive vs Inferential Statistics",
                        "Distributions and Probabilities",
                        "Hypothesis Testing and Confidence Intervals",
                        "Correlation vs Causation"
                    ]
                },
                {
                    "title": "Power BI",
                    "content": [
                        "Connecting data sources",
                        "Building interactive dashboards",
                        "DAX basics",
                        "Publishing and sharing reports"
                    ]
                },
                {
                    "title": "Python for Data Analysis",
                    "content": [
                        "Python basics: variables, loops, conditionals",
                        "Pandas and NumPy for data wrangling",
                        "Data cleaning and transformation",
                        "Working with APIs and files"
                    ]
                },
                {
                    "title": "Introduction to Data Science",
                    "content": [
                        "What is data science?",
                        "Machine learning basics",
                        "Project lifecycle overview",
                        "Real-world use cases"
                    ]
                }
            ],
